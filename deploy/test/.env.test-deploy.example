# ============================================
# Тестовое развёртывание БЕЗ домена (VPS Ruvds)
# Шаблон конфига.
# НЕ редактируйте этот файл — копия в .env
# создаётся скриптом 01-prepare-env.sh
# ============================================

# Публичный IP этого VPS (обязательно!)
# Используется как NEXTAUTH_URL, DOMAIN и CN/SAN сертификата.
PUBLIC_IP=""

# --- База данных (PostgreSQL на этом же VPS) ---
POSTGRES_USER="snt_user"
POSTGRES_PASSWORD="replace-me-strong-password"
POSTGRES_DB="snt_db"
# БД слушает только 127.0.0.1:5432 (bind на локальном VPS)
DB_BIND_ADDRESS="127.0.0.1"
DATABASE_URL="postgresql://snt_user:replace-me-strong-password@127.0.0.1:5432/snt_db?schema=public"

# --- NextAuth ---
# Обязательно https и хост = публичный IP (тот же, что в адресной строке браузера)
NEXTAUTH_URL="https://"
# Генерация: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
WS_INTERNAL_SECRET="replace-with-openssl-rand-base64-32"

# --- Тестовый "домен" (для self-signed сертификата, = PUBLIC_IP) ---
DOMAIN=""
ACME_EMAIL="test@example.com"   # не используется (certbot не запускается)

# --- Приложение (встраиваются в bundle на этапе build) ---
NEXT_PUBLIC_APP_NAME="СНТ Берёзки-НТ"
NEXT_PUBLIC_APP_DESCRIPTION="Управление садоводческим товариществом"
MAX_FILE_SIZE="10485760"

# --- Образ приложения (из registry; при отсутствии — собирается 05-start-app.sh) ---
IMAGE="snt-app/snt:latest"