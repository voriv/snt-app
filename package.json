{
  "name": "snt-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:ws": "pnpm --filter ws-server dev",
    "dev:all": "concurrently \"PORT=3100 next dev\" \"pnpm dev:ws\"",
    "dev:all:ws3101": "concurrently \"PORT=3100 next dev\" \"WS_PORT=3101 pnpm --filter ws-server dev\"",
    "build": "next build",
    "build:ws": "pnpm --filter ws-server build",
    "start": "next start",
    "start:all": "concurrently \"PORT=3100 next start\" \"pnpm --filter ws-server start\"",
    "start:ws": "pnpm --filter ws-server start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.1",
    "date-fns": "^3.6.0",
    "next": "^15.0.0",
    "next-auth": "^4.24.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.80.0",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.9.1",
    "eslint-config-next": "^15.0.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed.ts"
  }
}
