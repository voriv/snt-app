# ============================================
# Dockerfile для локальной разработки (hot-reload)
# ============================================
FROM node:24-alpine

WORKDIR /app

# Установка зависимостей для нативных модулей
RUN apk add --no-cache python3 make g++

# Копирование файлов зависимостей
COPY package.json package-lock.json ./

# Установка всех зависимостей
RUN npm ci

# Экспорт порта
EXPOSE 3000

# Команда по умолчанию (перезаписывается из docker-compose)
CMD ["npm", "run", "dev"]
