# ============================================
# Продакшен-шаблон для двухсерверной архитектуры (Ruvds)
# Скопируйте в .env на каждом VPS и заполните реальные значения.
# ============================================

# --------------------------------------------------
# VPS-A (app): Next.js + nginx + certbot
# Общие переменные (используются docker-compose.prod.yml)
# --------------------------------------------------
# Подключение к БД на VPS-DB через приватную сеть Ruvds.
# Обязательно укажите ПРИВАТНЫЙ (internal) IP VPS-DB, а не публичный.
DATABASE_URL="postgresql://snt_user:STRONG_PASSWORD@<INTERNAL_IP_VPS_DB>:5432/snt_db?schema=public"

# Публичный URL приложения и секреты NextAuth
NEXTAUTH_URL="https://snt-berezki-nt.ru"
# Генерация: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
# Секрет для будущего WS-сервера (зарезервирован)
WS_INTERNAL_SECRET="replace-with-openssl-rand-base64-32"

# Название и описание приложения (встраиваются в build на CI)
NEXT_PUBLIC_APP_NAME="СНТ Берёнки-НТ"
NEXT_PUBLIC_APP_DESCRIPTION="Управление садоводческим товариществом"

# Домен и email для Let's Encrypt
DOMAIN="snt-berezki-nt.ru"
ACME_EMAIL="admin@snt-berezki-nt.ru"

# Файлы (хранение в PostgreSQL bytea)
MAX_FILE_SIZE=10485760

# Образ приложения из container registry (сборка на CI).
# Docker Hub: snt-app/snt:<tag>. Публичный образ обычно не требует docker login,
# приватный — требует предварительного `docker login`.
IMAGE="snt-app/snt:latest"
# Для приватного registry укажите: IMAGE="registry.example.com/snt-app/snt:<tag>"

# --------------------------------------------------
# VPS-DB (db): PostgreSQL + backup в Object Storage
# Переменные для docker-compose.db.yml (только на VPS-DB)
# --------------------------------------------------
# Учётные данные БД (ДОЛЖНЫ совпадать с теми, что в DATABASE_URL на VPS-A)
POSTGRES_USER="snt_user"
POSTGRES_PASSWORD="STRONG_PASSWORD"
POSTGRES_DB="snt_db"

# На какой адрес слушает Postgres. Укажите приватный IP VPS-DB,
# чтобы БД была доступна VPS-A по приватной сети. Публичный НЕ использовать.
DB_BIND_ADDRESS="<INTERNAL_IP_VPS_DB>"

# Object Storage (S3-совместимое, например Ruvds Object Storage)
S3_ENDPOINT="https://s3.ru1.storage.beget.cloud"   # пример, замените на свой
S3_ACCESS_KEY="your-s3-access-key"
S3_SECRET_KEY="your-s3-secret-key"
S3_BUCKET="snt-backups"
S3_PREFIX="snt-prod"
S3_REGION="us-east-1"
# Хранение локально перед выгрузкой (0 = не хранить локально)
KEEP_LOCAL_DAYS="0"
# Ротация в S3: удалять бэкапы старше N дней (пусто = не удалять)
S3_MAX_DAYS="30"
