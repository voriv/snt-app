generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique @map("email")
  name                     String?                   @map("name")
  password                 String                    @map("password")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  plotUserHistories        PlotUserRoleHistory[]     @relation("HistoryChangedBy")
  plotUserRoles            PlotUserRole[]
  profile                  UserProfile?
  roles                    UserRole[]
  announcements            Announcement[]
  sentMessages             Message[]
  conversationParticipants ConversationParticipant[]
  documents                Document[]                @relation("DocumentUploadedBy")

  @@map("user")
}

model UserProfile {
  id          String   @id @default(cuid())
  user_id     String   @unique @map("user_id")
  first_name  String?  @map("first_name")
  middle_name String?  @map("middle_name")
  last_name   String?  @map("last_name")
  phone       String?  @map("phone")
  avatar      String?  @map("avatar")
  bio         String?  @map("bio")
  theme       String   @default("light") @map("theme")
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Plot {
  id               String         @id @default(cuid())
  plot_number      String         @unique @map("plot_number")
  cadastral_number String?        @unique @map("cadastral_number") @db.VarChar(20)
  area             Decimal        @map("area") @db.Decimal(10, 2)
  address          String?        @map("address")
  note             String?        @map("note")
  created_at       DateTime       @default(now()) @map("created_at")
  updated_at       DateTime       @updatedAt @map("updated_at")
  plotUserRoles    PlotUserRole[]

  @@map("plots")
}

/// Настраиваемая роль в системе RBAC. Системные роли защищены от удаления/переименования.
model Role {
  id           String            @id @default(cuid())
  name         String            @unique @map("name")
  description  String?           @map("description")
  isSystem     Boolean           @default(false) @map("is_system")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  apiEndpoints RoleApiEndpoint[]
  pages        RolePage[]
  users        UserRole[]

  @@map("roles")
}

/// Связь M:N users↔roles. Составной PK (userId, roleId). CASCADE при удалении.
model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Реестр страниц приложения. accessType: public, owner, role, super_admin (US-9).
model Page {
  id         String     @id @default(cuid())
  path       String     @unique @map("path")
  title      String     @map("title")
  groupName  String?    @map("group_name")
  sortOrder  Int        @default(0) @map("sort_order")
  accessType String     @default("role") @map("access_type")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  roles      RolePage[]

  @@map("pages")
}

/// Связь M:N roles↔pages. Составной PK (roleId, pageId). CASCADE при удалении.
model RolePage {
  roleId    String   @map("role_id")
  pageId    String   @map("page_id")
  createdAt DateTime @default(now()) @map("created_at")
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, pageId])
  @@map("role_pages")
}

/// Реестр API endpoints. Уникальная комбинация (method, path). path может содержать :param.
model ApiEndpoint {
  id          String            @id @default(cuid())
  method      String            @map("method")
  path        String            @map("path")
  description String?           @map("description")
  accessType  String            @default("role") @map("access_type")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  roles       RoleApiEndpoint[]

  @@unique([method, path])
  @@map("api_endpoints")
}

/// Связь M:N roles↔api_endpoints. Составной PK. CASCADE при удалении.
model RoleApiEndpoint {
  roleId        String      @map("role_id")
  apiEndpointId String      @map("api_endpoint_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  apiEndpoint   ApiEndpoint @relation(fields: [apiEndpointId], references: [id], onDelete: Cascade)
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, apiEndpointId])
  @@map("role_api_endpoints")
}

/// Глобальная версия конфигурации доступа (US-9). Однострочная таблица для инвалидации сессий.
model AccessConfigVersion {
  id        Int      @id @default(1)
  version   BigInt   @default(0) @map("version")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("access_config_version")
}

/// Связь между пользователем и участком. Определяет роль пользователя на участке.
model PlotUserRole {
  id         String                @id @default(cuid())
  userId     String                @map("user_id")
  plotId     String                @map("plot_id")
  role       Int                   @map("role")
  status     String                @default("active") @map("status")
  comment    String?               @map("comment") @db.VarChar(500)
  assignedAt DateTime              @default(now()) @map("assigned_at")
  expiresAt  DateTime?             @map("expires_at")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  history    PlotUserRoleHistory[]
  plot       Plot                  @relation(fields: [plotId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, plotId, role], name: "unique_user_plot_role")
  @@index([userId])
  @@index([plotId])
  @@map("plot_users")
}

/// История изменений связей пользователь-участок. Используется для аудита.
model PlotUserRoleHistory {
  id            String       @id @default(cuid())
  plotUserId    String       @map("plot_user_id")
  userId        String       @map("user_id")
  plotId        String       @map("plot_id")
  role          Int          @map("role")
  status        String       @map("status")
  comment       String?      @map("comment") @db.VarChar(500)
  changedBy     String       @map("changed_by")
  changedAt     DateTime     @default(now()) @map("changed_at")
  changedReason String       @default("Initial assignment") @map("changed_reason")
  oldValues     Json?        @map("old_values")
  newValues     Json?        @map("new_values")
  changedByUser User         @relation("HistoryChangedBy", fields: [changedBy], references: [id], onDelete: Cascade)
  plotUser      PlotUserRole @relation(fields: [plotUserId], references: [id], onDelete: Cascade)

  @@index([plotUserId])
  @@index([userId])
  @@index([plotId])
  @@map("plot_user_history")
}

// ============================================
// COMMS DOMAIN (US-21-01)
// ============================================

/// Тип диалога: личный, групповой или обсуждение объявления
enum ConversationType {
  DIRECT
  GROUP
  ANNOUNCEMENT
}

/// Роль участника в диалоге
enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

/// Диалог (разговор) между пользователями
///
/// ⚠️  BR-06/NFR-03 (B-029): поле pair_key вычисляется на уровне Prisma (sorted user IDs)
/// и хранится на диалоге (одна строка на диалог). Partial unique index на pair_key
/// (WHERE pair_key IS NOT NULL) предотвращает дублирование DIRECT-диалогов.
/// Для GROUP/ANNOUNCEMENT диалогов pair_key = NULL — индекс не применяется.
/// См. миграцию add_unique_direct_conversation_constraint.
model Conversation {
  id          String           @id @default(cuid())
  type        ConversationType @default(DIRECT) @map("type")
  title       String?          @map("title")
  description String?          @map("description") @db.Text
  plotId      String?          @map("plot_id")
  createdBy   String           @map("created_by")
  // B-029: детерминированный ключ пары для DIRECT-диалогов (sorted user IDs).
  // Одна строка на диалог → unique-индекс корректен и не конфликтует с двумя
  // строками участников. Для GROUP/ANNOUNCEMENT = NULL.
  pairKey     String?          @map("pair_key")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

/// Связь пользователь-диалог
model ConversationParticipant {
  id             String          @id @default(cuid())
  conversationId String          @map("conversation_id")
  userId         String          @map("user_id")
  role           ParticipantRole @default(MEMBER) @map("role")
  joinedAt       DateTime        @default(now()) @map("joined_at")
  lastReadAt     DateTime?       @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

/// Сообщение в диалоге
model Message {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  content        String    @map("content")
  replyToId      String?   @map("reply_to_id")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedBy      String?   @map("deleted_by")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================
// ANNOUNCEMENT DOMAIN (US-21-27)
// ============================================

/// Статус объявления
enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Объявление в СНТ
model Announcement {
  id          String             @id @default(cuid())
  title       String             @map("title") @db.VarChar(200)
  content     String             @map("content") @db.Text
  authorId    String             @map("author_id")
  publishedAt DateTime?          @map("published_at")
  archivedAt  DateTime?          @map("archived_at")
  status      AnnouncementStatus @default(DRAFT) @map("status")
  isImportant Boolean            @default(false) @map("is_important")
  viewCount   Int                @default(0) @map("view_count")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status, publishedAt])
  @@index([authorId])
  @@map("announcements")
}

// ============================================
// DOCUMENT DOMAIN (US-22-01...US-22-07)
// ============================================

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model DocumentCategory {
  id          String             @id @default(cuid())
  name        String             @map("name") @db.VarChar(100)
  description String?            @map("description") @db.VarChar(500)
  parent_id   String?            @map("parent_id")
  created_at  DateTime           @default(now()) @map("created_at")
  updated_at  DateTime           @updatedAt @map("updated_at")
  parent      DocumentCategory?  @relation("CategoryParent", fields: [parent_id], references: [id], onDelete: SetNull)
  children    DocumentCategory[] @relation("CategoryParent")
  documents   Document[]

  @@unique([name, parent_id])
  @@index([parent_id])
  @@map("document_categories")
}

model Document {
  id             String            @id @default(cuid())
  title          String            @map("title") @db.VarChar(255)
  description    String?           @map("description") @db.Text
  original_name  String            @map("original_name") @db.VarChar(255)
  storage_path   String?           @map("storage_path") @db.VarChar(500)
  file_size      Int               @map("file_size")
  mime_type      String            @map("mime_type") @db.VarChar(100)
  category_id    String?           @map("category_id")
  document_type  String            @map("document_type") @db.VarChar(50)
  visible_roles  Json              @map("visible_roles")
  status         DocumentStatus    @default(DRAFT) @map("status")
  uploaded_by_id String            @map("uploaded_by_id")
  created_at     DateTime          @default(now()) @map("created_at")
  updated_at     DateTime          @updatedAt @map("updated_at")
  category       DocumentCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  uploadedBy     User              @relation("DocumentUploadedBy", fields: [uploaded_by_id], references: [id], onDelete: Cascade)
  tags           DocumentTagLink[]

  @@index([category_id])
  @@index([document_type])
  @@index([status])
  @@index([status, created_at])
  @@index([uploaded_by_id])
  @@map("documents")
}

model DocumentTag {
  id            String            @id @default(cuid())
  name          String            @unique @map("name") @db.VarChar(50)
  created_at    DateTime          @default(now()) @map("created_at")
  documentLinks DocumentTagLink[]

  @@map("document_tags")
}

model DocumentTagLink {
  document_id String      @map("document_id")
  tag_id      String      @map("tag_id")
  document    Document    @relation(fields: [document_id], references: [id], onDelete: Cascade)
  tag         DocumentTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([document_id, tag_id])
  @@index([tag_id])
  @@map("document_tag_links")
}
