generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique @map("email")
  name      String?    @map("name")
  password  String     @map("password")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  members   Member?
  profile   UserProfile?
  roles     UserRole[]
}

model UserProfile {
  id         String   @id @default(cuid())
  user_id    String   @unique @map("user_id")
  first_name String?  @map("first_name")
  middle_name String? @map("middle_name")
  last_name  String?  @map("last_name")
  phone      String?  @map("phone")
  avatar     String?  @map("avatar")
  bio        String?  @map("bio")
  theme      String   @default("light") @map("theme")
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Member {
  id         String      @id @default(cuid())
  user_id    String      @unique @map("user_id")
  first_name String      @map("first_name")
  last_name  String      @map("last_name")
  birth_date DateTime?   @map("birth_date")
  phone      String?     @map("phone")
  email      String?     @map("email")
  is_active  Boolean     @default(true) @map("is_active")
  note       String?     @map("note")
  created_at DateTime    @default(now()) @map("created_at")
  updated_at DateTime    @updatedAt @map("updated_at")
  agreements Agreement[]
  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payments   Payment[]
  plot       Plot?

  @@map("members")
}

model Plot {
  id          String      @id @default(cuid())
  plot_number String      @unique @map("plot_number")
  area        Decimal     @map("area") @db.Decimal(10, 2)
  address     String?     @map("address")
  note        String?     @map("note")
  member_id   String?     @unique @map("member_id")
  created_at  DateTime    @default(now()) @map("created_at")
  updated_at  DateTime    @updatedAt @map("updated_at")
  agreements  Agreement[]
  payments    Payment[]
  member      Member?     @relation(fields: [member_id], references: [id])

  @@map("plots")
}

model Agreement {
  id         String          @id @default(cuid())
  type       String          @map("type")
  start_date DateTime        @map("start_date")
  end_date   DateTime?       @map("end_date")
  amount     Decimal         @map("amount") @db.Decimal(10, 2)
  status     AgreementStatus @default(DRAFT) @map("status")
  note       String?         @map("note")
  member_id  String          @map("member_id")
  plot_id    String?         @map("plot_id")
  created_at DateTime        @default(now()) @map("created_at")
  updated_at DateTime        @updatedAt @map("updated_at")
  member     Member          @relation(fields: [member_id], references: [id], onDelete: Cascade)
  plot       Plot?           @relation(fields: [plot_id], references: [id])

  @@map("agreements")
}

model Payment {
  id          String        @id @default(cuid())
  amount      Decimal       @map("amount") @db.Decimal(10, 2)
  date        DateTime      @default(now()) @map("date")
  description String?       @map("description")
  status      PaymentStatus @default(PENDING) @map("status")
  member_id   String        @map("member_id")
  plot_id     String?       @map("plot_id")
  created_at  DateTime      @default(now()) @map("created_at")
  updated_at  DateTime      @updatedAt @map("updated_at")
  member      Member        @relation(fields: [member_id], references: [id], onDelete: Cascade)
  plot        Plot?         @relation(fields: [plot_id], references: [id])

  @@map("payments")
}

// ============================================================================
// Ролевая модель RBAC (US-8)
// ============================================================================

/// Настраиваемая роль в системе RBAC. Системные роли защищены от удаления/переименования.
model Role {
  id          String             @id @default(cuid())
  name        String             @unique @map("name")
  description String?            @map("description")
  isSystem    Boolean            @default(false) @map("is_system")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  users       UserRole[]
  pages       RolePage[]
  apiEndpoints RoleApiEndpoint[]

  @@map("roles")
}

/// Связь M:N users↔roles. Составной PK (userId, roleId). CASCADE при удалении.
model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Реестр страниц приложения. accessType: public, owner, role, super_admin (US-9).
model Page {
  id         String      @id @default(cuid())
  path       String      @unique @map("path")
  title      String      @map("title")
  groupName  String?     @map("group_name")
  sortOrder   Int         @default(0) @map("sort_order")
  accessType String      @default("role") @map("access_type")
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  roles      RolePage[]

  @@map("pages")
}

/// Связь M:N roles↔pages. Составной PK (roleId, pageId). CASCADE при удалении.
model RolePage {
  roleId    String   @map("role_id")
  pageId    String   @map("page_id")
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([roleId, pageId])
  @@map("role_pages")
}

/// Реестр API endpoints. Уникальная комбинация (method, path). path может содержать :param.
model ApiEndpoint {
  id          String             @id @default(cuid())
  method      String             @map("method")
  path        String             @map("path")
  description String?            @map("description")
  accessType  String             @default("role") @map("access_type")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  roles       RoleApiEndpoint[]

  @@unique([method, path])
  @@map("api_endpoints")
}

/// Связь M:N roles↔api_endpoints. Составной PK. CASCADE при удалении.
model RoleApiEndpoint {
  roleId        String      @map("role_id")
  apiEndpointId String      @map("api_endpoint_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  apiEndpoint   ApiEndpoint @relation(fields: [apiEndpointId], references: [id], onDelete: Cascade)

  @@id([roleId, apiEndpointId])
  @@map("role_api_endpoints")
}

/// Глобальная версия конфигурации доступа (US-9). Однострочная таблица для инвалидации сессий.
model AccessConfigVersion {
  id        Int      @id @default(1)
  version   BigInt   @default(0) @map("version")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("access_config_version")
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}
