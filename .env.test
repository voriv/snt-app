# Тестовая база данных (Docker)
DATABASE_URL="postgresql://test:test@localhost:54320/snt_test?schema=public"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="test-secret-for-testing-only-change-in-production"

# WebSocket сервер
WS_PORT=3101
WS_INTERNAL_SECRET="test-internal-secret"

# Название и описание приложения
NEXT_PUBLIC_APP_NAME="СНТ Берёзки-НТ"
NEXT_PUBLIC_APP_DESCRIPTION="Управление садоводческим товариществом"

# Файлы
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Тестовые роуты (только для e2e/dev). В production всегда выключать.
ENABLE_TEST_ROUTES="true"
