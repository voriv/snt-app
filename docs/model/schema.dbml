Project "snt_berezhki_nt" {
  note: "Концептуальная модель данных для системы управления СНТ Березки НТ"
  note: "Все имена таблиц и колонок в snake_case"
  note: "Prisma использует @map для маппинга на snake_case"
}

// ============================================
// Table: users
// ============================================
Table users {
  id           varchar       [pk, not null] // cuid()
  email        varchar       [unique, not null]
  name         varchar
  password     varchar       [not null]
  role         varchar       [not null, ref: > roles]
  avatar       varchar
  created_at   timestamp     [default: now(), not null]
  updated_at   timestamp     [default: now(), not null]

  Notes:'''
    Primary key: id
    Unique constraint: email
    Default role: GUEST
    '''
}

// ============================================
// Table: user_profiles
// ============================================
Table user_profiles {
  id           varchar       [pk, not null] // cuid()
  user_id      varchar       [unique, not null, ref: > users]
  first_name   varchar       [not null]
  middle_name  varchar
  last_name    varchar       [not null]
  phone        varchar
  avatar       varchar
  bio          varchar
  created_at   timestamp     [default: now(), not null]
  updated_at   timestamp     [default: now(), not null]

  Notes:'''
    Primary key: id
    Unique constraint: user_id
    Foreign key: user_id -> users.id
    '''
}

// ============================================
// Table: plots
// ============================================
Table plots {
  id              varchar       [pk, not null] // cuid()
  plot_number     varchar       [unique, not null]
  cadastral_number varchar      [unique, not null]
  area            "decimal(10, 2)" [not null]
  address         varchar
  note            varchar
  created_at      timestamp     [default: now(), not null]
  updated_at      timestamp     [default: now(), not null]

  Notes:'''
    Primary key: id
    Unique constraint: plot_number, cadastral_number
    '''
}

// ============================================
// Table: plot_users (US-19-1)
// ============================================
Table plot_users {
  id              varchar       [pk, not null] // cuid()
  user_id         varchar       [not null, ref: > users.id]
  plot_id         varchar       [not null, ref: > plots.id]
  role            integer       [not null, note: '1=owner, 2=resident, 3=representative']
  status          varchar       [not null, default: 'active', note: 'active, pending, expired']
  comment         varchar       [note: 'max 500 chars']
  assigned_at     timestamp     [default: now(), not null]
  expires_at      timestamp
  created_at      timestamp     [default: now(), not null]
  updated_at      timestamp     [default: now(), not null]

  indexes {
    user_id
    plot_id
    (user_id, plot_id, status) [unique, name: 'unique_active_user_plot']
  }

  Notes:'''
    Primary key: id
    Foreign keys: user_id -> users.id, plot_id -> plots.id
    Unique constraint: (user_id, plot_id, status='active')
    BR-1: Множественные роли на одном участке разрешены
    BR-2: Множественные владельцы на одном участке разрешены
    BR-3: Одна активная связь на пару (user_id, plot_id)
    '''
}

// ============================================
// Table: plot_user_history (US-19-1)
// ============================================
Table plot_user_history {
  id              varchar       [pk, not null] // cuid()
  plot_user_id    varchar       [not null, ref: > plot_users.id]
  user_id         varchar       [not null, ref: > users.id]
  plot_id         varchar       [not null, ref: > plots.id]
  role            integer       [not null, note: 'копия роли на момент изменения']
  status          varchar       [not null, note: 'копия статуса на момент изменения']
  comment         varchar       [note: 'копия комментария на момент изменения']
  changed_by      varchar       [not null, ref: > users.id, note: 'ID администратора']
  changed_at      timestamp     [default: now(), not null]
  changed_reason  varchar       [not null, default: 'Initial assignment', note: 'причина изменения']

  indexes {
    plot_user_id
    user_id
    plot_id
  }

  Notes:'''
    Primary key: id
    Foreign keys: plot_user_id -> plot_users.id, user_id -> users.id, plot_id -> plots.id, changed_by -> users.id
    BR-7: История создаётся транзакционно с основной записью
    '''
}

// ============================================
// Enums
// ============================================
Enum roles {
  GUEST
  MEMBER
  ADMIN
}

Enum plot_user_role_enum {
  OWNER [note: '1']
  RESIDENT [note: '2']
  REPRESENTATIVE [note: '3']
}

Enum plot_user_status_enum {
  active
  pending
  expired
}

// ============================================
// Relationships
// ============================================
Ref: user_profiles.user_id > users.id
Ref: plot_users.user_id > users.id
Ref: plot_users.plot_id > plots.id
Ref: plot_user_history.plot_user_id > plot_users.id
Ref: plot_user_history.user_id > users.id
Ref: plot_user_history.plot_id > plots.id
Ref: plot_user_history.changed_by > users.id
