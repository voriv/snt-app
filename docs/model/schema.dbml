Project "snt_berezhki_nt" {
  note: "Концептуальная модель данных для системы управления СНТ Березки НТ"
  note: "Все имена таблиц и колонок в snake_case"
  note: "Prisma использует @map для маппинга на snake_case"
}

// ============================================
// Table: users
// ============================================
Table users {
  id           varchar       [pk, not null] // cuid()
  email        varchar       [unique, not null]
  name         varchar
  password     varchar       [not null]
  role         varchar       [not null, ref: > roles]
  avatar       varchar
  created_at   timestamp     [default: now(), not null]
  updated_at   timestamp     [default: now(), not null]

  Notes:'''
    Primary key: id
    Unique constraint: email
    Default role: GUEST
    '''
}

// ============================================
// Table: user_profiles
// ============================================
Table user_profiles {
  id           varchar       [pk, not null] // cuid()
  user_id      varchar       [unique, not null, ref: > users]
  first_name   varchar       [not null]
  middle_name  varchar
  last_name    varchar       [not null]
  phone        varchar
  avatar       varchar
  bio          varchar
  created_at   timestamp     [default: now(), not null]
  updated_at   timestamp     [default: now(), not null]

  Notes:'''
    Primary key: id
    Unique constraint: user_id
    Foreign key: user_id -> users.id
    '''
}

// ============================================
// Table: plots
// ============================================
Table plots {
  id              varchar       [pk, not null] // cuid()
  plot_number     varchar       [unique, not null]
  cadastral_number varchar      [unique, not null]
  area            "decimal(10, 2)" [not null]
  address         varchar
  note            varchar
  created_at      timestamp     [default: now(), not null]
  updated_at      timestamp     [default: now(), not null]

  Notes:'''
    Primary key: id
    Unique constraint: plot_number, cadastral_number
    '''
}

// ============================================
// Table: plot_users (US-19-1)
// ============================================
Table plot_users {
  id              varchar       [pk, not null] // cuid()
  user_id         varchar       [not null, ref: > users.id]
  plot_id         varchar       [not null, ref: > plots.id]
  role            integer       [not null, note: '1=owner, 2=resident, 3=representative']
  status          varchar       [not null, default: 'active', note: 'active, pending, expired']
  comment         varchar       [note: 'max 500 chars']
  assigned_at     timestamp     [default: now(), not null]
  expires_at      timestamp
  created_at      timestamp     [default: now(), not null]
  updated_at      timestamp     [default: now(), not null]

  indexes {
    user_id
    plot_id
    (user_id, plot_id, status) [unique, name: 'unique_active_user_plot']
  }

  Notes:'''
    Primary key: id
    Foreign keys: user_id -> users.id, plot_id -> plots.id
    Unique constraint: (user_id, plot_id, status='active')
    BR-1: Множественные роли на одном участке разрешены
    BR-2: Множественные владельцы на одном участке разрешены
    BR-3: Одна активная связь на пару (user_id, plot_id)
    '''
}

// ============================================
// Table: plot_user_history (US-19-1)
// ============================================
Table plot_user_history {
  id              varchar       [pk, not null] // cuid()
  plot_user_id    varchar       [not null, ref: > plot_users.id]
  user_id         varchar       [not null, ref: > users.id]
  plot_id         varchar       [not null, ref: > plots.id]
  role            integer       [not null, note: 'копия роли на момент изменения']
  status          varchar       [not null, note: 'копия статуса на момент изменения']
  comment         varchar       [note: 'копия комментария на момент изменения']
  changed_by      varchar       [not null, ref: > users.id, note: 'ID администратора']
  changed_at      timestamp     [default: now(), not null]
  changed_reason  varchar       [not null, default: 'Initial assignment', note: 'причина изменения']

  indexes {
    plot_user_id
    user_id
    plot_id
  }

  Notes:'''
    Primary key: id
    Foreign keys: plot_user_id -> plot_users.id, user_id -> users.id, plot_id -> plots.id, changed_by -> users.id
    BR-7: История создаётся транзакционно с основной записью
    '''
}

// ============================================
// Enums
// ============================================
Enum roles {
  GUEST
  MEMBER
  ADMIN
}

Enum plot_user_role_enum {
  OWNER [note: '1']
  RESIDENT [note: '2']
  REPRESENTATIVE [note: '3']
}

Enum plot_user_status_enum {
  active
  pending
  expired
}

Enum conversation_type {
  DIRECT [note: 'Личный диалог']
  GROUP [note: 'Групповой чат']
  ANNOUNCEMENT [note: 'Чат обсуждения объявления']
}

Enum participant_role {
  OWNER
  ADMIN
  MEMBER
}

// ============================================
// Table: conversations (US-21-01)
// ============================================
Table conversations {
  id           varchar       [pk, not null] // cuid()
  type         varchar       [not null, default: 'DIRECT', ref: > conversation_type]
  title        varchar
  plot_id      varchar       [ref: > plots.id]
  created_by   varchar       [not null, ref: > users.id]
  created_at   timestamp     [default: now(), not null]
  updated_at   timestamp     [default: now(), not null]

  Notes:'''
    Primary key: id
    Foreign keys: plot_id -> plots.id (optional), created_by -> users.id
    Default type: DIRECT
    '''
}

// ============================================
// Table: conversation_participants (US-21-01)
// ============================================
Table conversation_participants {
  id                   varchar       [pk, not null] // cuid()
  conversation_id      varchar       [not null, ref: > conversations.id]
  user_id              varchar       [not null, ref: > users.id]
  role                 varchar       [not null, default: 'MEMBER', ref: > participant_role]
  joined_at            timestamp     [default: now(), not null]
  last_read_at         timestamp

  indexes {
    (conversation_id, user_id) [unique, name: 'unique_conversation_user']
    user_id
  }

  Notes:'''
    Primary key: id
    Foreign keys: conversation_id -> conversations.id, user_id -> users.id
    Unique constraint: (conversation_id, user_id)
    '''
}

// ============================================
// Table: messages (US-21-01)
// ============================================
Table messages {
  id              varchar       [pk, not null] // cuid()
  conversation_id varchar       [not null, ref: > conversations.id]
  sender_id       varchar       [not null, ref: > users.id]
  content         varchar       [not null]
  reply_to_id     varchar       [ref: > messages.id]
  is_deleted      boolean       [not null, default: false]
  deleted_by      varchar       [ref: > users.id]
  deleted_at      timestamp
  created_at      timestamp     [default: now(), not null]
  updated_at      timestamp     [default: now(), not null]

  indexes {
    (conversation_id, created_at)
  }

  Notes:'''
    Primary key: id
    Foreign keys: conversation_id -> conversations.id, sender_id -> users.id, reply_to_id -> messages.id, deleted_by -> users.id
    Soft-delete support via is_deleted flag
    '''
}

// ============================================
// Table: announcements (US-21-27)
// ============================================
Table announcements {
  id            varchar       [pk, not null] // cuid()
  title         varchar       [not null]
  content       varchar       [not null]
  author_id     varchar       [not null, ref: > users.id]
  published_at  timestamp
  archived_at   timestamp
  status        varchar       [not null, default: 'DRAFT', ref: > announcement_status]
  is_important  boolean       [not null, default: false]
  view_count    int           [not null, default: 0]
  created_at    timestamp     [default: now(), not null]
  updated_at    timestamp     [default: now(), not null]

  indexes {
    (status, published_at)
    author_id
  }

  Notes:'''
    Primary key: id
    Foreign key: author_id -> users.id
    Default status: DRAFT
    Default view_count: 0
    Default is_important: false
    '''
}

Enum announcement_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ============================================
// Relationships
// ============================================
Ref: user_profiles.user_id > users.id
Ref: plot_users.user_id > users.id
Ref: plot_users.plot_id > plots.id
Ref: plot_user_history.plot_user_id > plot_users.id
Ref: plot_user_history.user_id > users.id
Ref: plot_user_history.plot_id > plots.id
Ref: plot_user_history.changed_by > users.id
Ref: conversations.plot_id > plots.id
Ref: conversations.created_by > users.id
Ref: conversation_participants.conversation_id > conversations.id
Ref: conversation_participants.user_id > users.id
Ref: messages.conversation_id > conversations.id
Ref: messages.sender_id > users.id
Ref: messages.reply_to_id > messages.id
Ref: messages.deleted_by > users.id
Ref: announcements.author_id > users.id
